<Project>
	<PropertyGroup>
		<TargetFrameworks>net472</TargetFrameworks>
		<Company>Eberhard Beilharz</Company>
		<Authors>Eberhard Beilharz</Authors>
		<Product>DigitaleBriefwahl</Product>
		<Copyright>Copyright © 2017-$([System.DateTime]::Now.ToString("yyyy")) Eberhard Beilharz</Copyright>
		<OutputPath>$(MSBuildThisFileDirectory)/output/$(Configuration)</OutputPath>
		<DebugType>portable</DebugType>
		<!-- LangVersion 8 is the highest available with Mono 6 -->
		<LangVersion>8</LangVersion>
	</PropertyGroup>
</Project>
